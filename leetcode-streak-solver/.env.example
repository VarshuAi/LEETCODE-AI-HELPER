# LeetCode Credentials
# Get these values from your browser's Developer Tools (Network Tab) after logging in to leetcode.com
LEETCODE_SESSION=your_leetcode_session_cookie_value
LEETCODE_CSRFTOKEN=your_leetcode_csrftoken_value

# Gemini API Configurations
GEMINI_API_KEY=your_google_gemini_api_key

# Solver Configuration (default: python3)
# Supported options include: python3, cpp, java, javascript
LEETCODE_LANGUAGE=python3
